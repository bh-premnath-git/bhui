# Use npmjs for everything by default
registry=https://registry.npmjs.org/

# Any @bh-ai/* package comes from CodeArtifact
@bh-ai:registry=https://bighammer-058264070106.d.codeartifact.us-east-1.amazonaws.com/npm/bh-npm-repo/

# Force auth every time and pull the token from env
//bighammer-058264070106.d.codeartifact.us-east-1.amazonaws.com/npm/bh-npm-repo/:always-auth=true
//bighammer-058264070106.d.codeartifact.us-east-1.amazonaws.com/npm/bh-npm-repo/:_authToken=${CODEARTIFACT_AUTH_TOKEN}

